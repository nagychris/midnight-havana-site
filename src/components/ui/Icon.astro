---
/**
 * Every icon on the site, inline.
 *
 * Inline rather than loaded from an icon CDN: a third-party request would send
 * visitor IP addresses to another company on every page view, and would be one
 * more thing that can be slow or go away.
 *
 * Icons are decorative by default. Pass a `title` when the icon is the only
 * label on a control, and it becomes an accessible name instead.
 */
export type IconName =
    | 'instagram'
    | 'whatsapp'
    | 'globe'
    | 'chevron-down'
    | 'arrow-right'
    | 'external'
    | 'map-pin'
    | 'clock'
    | 'check'
    | 'menu'
    | 'close';

interface Props {
    name: IconName;
    size?: number;
    title?: string;
    class?: string;
}

const { name, size = 20, title, class: className } = Astro.props;

/* Stroked paths, 24x24 box, except the two brand marks which are filled. */
const filledIcons: IconName[] = ['instagram', 'whatsapp'];
const isFilled = filledIcons.includes(name);
---

<svg
    xmlns="http://www.w3.org/2000/svg"
    width={size}
    height={size}
    viewBox="0 0 24 24"
    fill={isFilled ? 'currentColor' : 'none'}
    stroke={isFilled ? 'none' : 'currentColor'}
    stroke-width="1.7"
    stroke-linecap="round"
    stroke-linejoin="round"
    class:list={['shrink-0', className]}
    role={title ? 'img' : undefined}
    aria-hidden={title ? undefined : 'true'}
    aria-label={title}
    focusable="false"
>
    {title && <title>{title}</title>}

    {name === 'instagram' && (
        <path d="M12 2.16c3.2 0 3.58.01 4.85.07 1.17.05 1.8.25 2.23.41.56.22.96.48 1.38.9.42.42.68.82.9 1.38.16.42.36 1.06.41 2.23.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.05 1.17-.25 1.8-.41 2.23-.22.56-.48.96-.9 1.38-.42.42-.82.68-1.38.9-.42.16-1.06.36-2.23.41-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-1.17-.05-1.8-.25-2.23-.41a3.7 3.7 0 0 1-1.38-.9 3.7 3.7 0 0 1-.9-1.38c-.16-.42-.36-1.06-.41-2.23-.06-1.27-.07-1.65-.07-4.85s.01-3.58.07-4.85c.05-1.17.25-1.8.41-2.23.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.42-.16 1.06-.36 2.23-.41 1.27-.06 1.65-.07 4.85-.07Zm0 5.68a4.16 4.16 0 1 0 0 8.32 4.16 4.16 0 0 0 0-8.32Zm0 6.86a2.7 2.7 0 1 1 0-5.4 2.7 2.7 0 0 1 0 5.4Zm5.3-7.02a.97.97 0 1 1-1.94 0 .97.97 0 0 1 1.94 0Z" />
    )}

    {name === 'whatsapp' && (
        <path d="M12.04 2C6.6 2 2.18 6.42 2.18 11.86c0 1.74.45 3.44 1.32 4.94L2.1 22l5.34-1.4a9.83 9.83 0 0 0 4.6 1.17h.01c5.43 0 9.85-4.42 9.85-9.86 0-2.63-1.03-5.11-2.89-6.97A9.8 9.8 0 0 0 12.04 2Zm0 18.02h-.01a8.2 8.2 0 0 1-4.17-1.14l-.3-.18-3.1.81.83-3.02-.2-.31a8.15 8.15 0 0 1-1.25-4.32c0-4.52 3.68-8.2 8.2-8.2 2.19 0 4.25.86 5.8 2.41a8.15 8.15 0 0 1 2.4 5.8c0 4.52-3.68 8.15-8.2 8.15Zm4.5-6.1c-.25-.13-1.46-.72-1.68-.8-.23-.09-.39-.13-.55.12-.17.25-.64.8-.78.97-.14.16-.29.18-.53.06-.25-.13-1.04-.39-1.98-1.23-.73-.65-1.23-1.46-1.37-1.7-.15-.25-.02-.39.1-.51.11-.11.25-.29.37-.44.13-.14.17-.25.25-.41.09-.17.04-.31-.02-.44-.06-.12-.55-1.33-.76-1.82-.2-.48-.4-.41-.55-.42h-.47c-.16 0-.43.06-.65.31-.23.25-.86.84-.86 2.05s.88 2.38 1 2.54c.13.17 1.74 2.65 4.2 3.72.59.25 1.05.4 1.4.52.6.18 1.13.16 1.56.1.48-.07 1.46-.6 1.67-1.18.2-.58.2-1.07.15-1.18-.06-.1-.22-.17-.47-.29Z" />
    )}

    {name === 'globe' && (
        <>
            <circle cx="12" cy="12" r="9" />
            <path d="M3 12h18M12 3a15 15 0 0 1 0 18 15 15 0 0 1 0-18Z" />
        </>
    )}

    {name === 'chevron-down' && <path d="m6 9 6 6 6-6" />}

    {name === 'arrow-right' && <path d="M4 12h15m-6-6 6 6-6 6" />}

    {name === 'external' && (
        <path d="M14 4h6v6M20 4 10 14M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5" />
    )}

    {name === 'map-pin' && (
        <>
            <path d="M12 21s7-6.4 7-11.5A7 7 0 0 0 5 9.5C5 14.6 12 21 12 21Z" />
            <circle cx="12" cy="9.5" r="2.6" />
        </>
    )}

    {name === 'clock' && (
        <>
            <circle cx="12" cy="12" r="9" />
            <path d="M12 7v5l3.2 1.9" />
        </>
    )}

    {name === 'check' && <path d="m4.5 12.5 5 5 10-11" />}

    {name === 'menu' && <path d="M4 7h16M4 12h16M4 17h16" />}

    {name === 'close' && <path d="M6 6l12 12M18 6 6 18" />}
</svg>
