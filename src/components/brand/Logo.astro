---
import { Image } from 'astro:assets';
import logoVinyl from '../../assets/brand/logo-vinyl.png';

/**
 * The vinyl record mark. Square, transparent background.
 */
interface Props {
    size?: number;
    /** Decorative by default: the wordmark next to it already names the brand. */
    alt?: string;
    loading?: 'eager' | 'lazy';
    class?: string;
}

const { size = 48, alt = '', loading = 'lazy', class: className } = Astro.props;
---

{/* `width` and `height` are the display size; `densities` generates the 2x file
    for the srcset. Sizing it through the attributes rather than a `style` rule
    keeps it working under the Content Security Policy, which blocks inline
    style in the built site. */}
<Image
    src={logoVinyl}
    alt={alt}
    width={size}
    height={size}
    densities={[1, 2]}
    format="webp"
    quality={90}
    loading={loading}
    decoding={loading === 'eager' ? 'sync' : 'async'}
    class:list={['aspect-square', className]}
/>
