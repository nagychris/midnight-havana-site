---
import { Image } from "astro:assets";
import logo from "../assets/logo-round.png";
import wordmark from "../assets/wordmark.png";
import Globe from "./icons/Globe.astro";
import Instagram from "./icons/Instagram.astro";
import Whatsapp from "./icons/Whatsapp.astro";

interface Props {
  /** Artboard prop `showLangSwitcher` (was <sc-if value="{{ langSwitcher }}">). */
  showLangSwitcher?: boolean;
}
const { showLangSwitcher = true } = Astro.props;

const navLinks = [
  { href: "#dates", label: "Next dates" },
  { href: "#start", label: "New here?" },
  { href: "#courses", label: "Classes" },
  { href: "#venue", label: "Venue" },
  { href: "#faq", label: "FAQ" },
];
---

<header class="mh-header bg-ink/82 border-b border-gold/16 backdrop-blur-[14px]">
  <div
    class="mx-auto flex max-w-[1240px] items-center gap-7 px-8 py-3.5 max-sm:gap-4 max-sm:px-5"
  >
    <a href="#top" class="mr-auto flex flex-none items-center gap-3">
      <!-- Decorative: the wordmark beside it already names the brand. -->
      <Image
        src={logo}
        alt=""
        width={114}
        format="webp"
        quality={88}
        loading="eager"
        class="block h-[38px] w-[38px]"
      />
      <!-- The flyer's own lettering. Two stacked lines, so it's sized by height. -->
      <Image
        src={wordmark}
        alt="Midnight Havana"
        width={230}
        format="webp"
        quality={90}
        loading="eager"
        class="block h-11 w-auto max-sm:h-9"
      />
    </a>

    <nav
      class="mh-nav ml-auto flex items-center gap-[30px] text-base-plus tracking-tight-2"
    >
      {
        navLinks.map((link) => (
          <a href={link.href} class="text-cream/78 hover:text-gold-light">
            {link.label}
          </a>
        ))
      }
    </nav>

    <!-- One control cluster, so a tighter gap than the header's 28px rhythm. -->
    <div class="flex flex-none items-center gap-2">
      {
        showLangSwitcher && (
          <div class="mh-lang relative flex flex-none items-center text-gold-light">
            <span
              class="pointer-events-none absolute left-[11px] text-gold"
              aria-hidden="true"
            >
              <Globe />
            </span>
            <select
              aria-label="Language"
              class="font-display h-[42px] cursor-pointer appearance-none rounded-sharp border border-gold/40 bg-transparent pr-[26px] pl-[32px] text-xs-plus font-normal tracking-wide-14 text-gold-light"
            >
              <option value="EN" class="bg-surface text-cream">EN</option>
              <option value="DE" class="bg-surface text-cream">DE</option>
              <option value="ES" class="bg-surface text-cream">ES</option>
            </select>
            <span
              class="pointer-events-none absolute right-[10px] text-4xs text-gold"
              aria-hidden="true"
            >
              ▼
            </span>
          </div>
        )
      }

      <!-- Below 620px these move into the burger menu; the bar clips otherwise. -->
      <a
        href="#community"
        aria-label="Join the WhatsApp community"
        title="WhatsApp community"
        class="flex h-[42px] w-[42px] flex-none items-center justify-center rounded-sharp border border-gold/40 text-gold-light hover:bg-gold/14 max-sm:hidden"
      >
        <Whatsapp />
      </a>

      <a
        href="https://www.instagram.com/midnight.havana/"
        target="_blank"
        rel="noopener"
        aria-label="Follow Midnight Havana on Instagram"
        title="@midnight.havana"
        class="flex h-[42px] w-[42px] flex-none items-center justify-center rounded-sharp bg-orange text-ink hover:bg-orange-hover max-sm:hidden"
      >
        <Instagram />
      </a>

      <button
        type="button"
        class="mh-burger text-gold-light"
        aria-label="Menu"
        aria-expanded="false"
        aria-controls="mh-mobile-menu"
      >
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>

  <!-- ADDED: the artboard had a burger with no menu behind it. Absolute so it
       overlays the page instead of growing the header. -->
  <div
    id="mh-mobile-menu"
    hidden
    class="absolute inset-x-0 top-full hidden max-h-[calc(100vh-70px)] overflow-y-auto border-t border-gold/16 bg-ink/95 shadow-[0_18px_40px_rgba(11,9,8,.55)] backdrop-blur-[14px] 2xl:hidden"
  >
    <nav class="mx-auto flex max-w-[1240px] flex-col px-8 py-2 max-sm:px-5">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class="font-display border-b border-gold/12 py-4 text-base-plus tracking-wide-16 text-cream/78 uppercase last:border-b-0 hover:text-gold-light"
          >
            {link.label}
          </a>
        ))
      }
      {
        showLangSwitcher && (
          <div class="flex items-center gap-3 py-4">
            <span class="font-display text-xs tracking-wide-22 text-cream/40 uppercase">
              Language
            </span>
            <select
              aria-label="Language"
              class="font-display h-[38px] cursor-pointer appearance-none rounded-sharp border border-gold/40 bg-transparent px-3.5 text-xs-plus tracking-wide-14 text-gold-light"
            >
              <option value="EN" class="bg-surface text-cream">EN</option>
              <option value="DE" class="bg-surface text-cream">DE</option>
              <option value="ES" class="bg-surface text-cream">ES</option>
            </select>
          </div>
        )
      }

      <!-- Shown only at the widths where the bar drops them. -->
      <div class="flex flex-col gap-2.5 pt-1 pb-4 sm:hidden">
        <a
          href="https://www.instagram.com/midnight.havana/"
          target="_blank"
          rel="noopener"
          class="font-display flex items-center justify-center gap-[11px] rounded-sharp bg-orange px-5 py-3.5 text-xs-plus font-medium tracking-wide-16 text-ink uppercase hover:bg-orange-hover hover:text-ink"
        >
          <Instagram />
          Instagram
        </a>
        <a
          href="#community"
          class="font-display flex items-center justify-center gap-[11px] rounded-sharp border border-gold/50 px-5 py-3.5 text-xs-plus font-medium tracking-wide-16 text-gold-light uppercase hover:bg-gold/12 hover:text-cream"
        >
          <Whatsapp />
          WhatsApp community
        </a>
      </div>
    </nav>
  </div>
</header>

<script>
  // Scroll-hide ported from the artboard's DCLogic class. The 4px and 160px
  // thresholds are the design's — they're what stop it flickering.
  const header = document.querySelector<HTMLElement>(".mh-header");
  const burger = document.querySelector<HTMLButtonElement>(".mh-burger");
  const menu = document.querySelector<HTMLElement>("#mh-mobile-menu");

  if (header) {
    // Keeps the hero's height calc exact, whatever the bar ends up measuring.
    const syncHeight = () =>
      document.documentElement.style.setProperty(
        "--mh-header-h",
        `${header.offsetHeight}px`,
      );
    syncHeight();
    window.addEventListener("resize", syncHeight);

    let lastY = window.scrollY || 0;
    let hidden = false;

    const onScroll = () => {
      const y = window.scrollY || document.documentElement.scrollTop || 0;
      const down = y > lastY + 4;
      const up = y < lastY - 4;

      // Never hide the header while the mobile menu is open.
      const menuOpen = burger?.getAttribute("aria-expanded") === "true";

      if (down && y > 160 && !hidden && !menuOpen) {
        hidden = true;
        header.classList.add("mh-hidden");
      } else if (up && hidden) {
        hidden = false;
        header.classList.remove("mh-hidden");
      }

      if (down || up) lastY = y;
    };

    window.addEventListener("scroll", onScroll, { passive: true });
  }

  if (burger && menu) {
    const setOpen = (open: boolean) => {
      burger.setAttribute("aria-expanded", String(open));
      menu.hidden = !open;
      menu.classList.toggle("hidden", !open);
    };

    const isOpen = () => burger.getAttribute("aria-expanded") === "true";

    burger.addEventListener("click", (event) => {
      event.stopPropagation();
      setOpen(!isOpen());
    });

    // Close on navigation.
    menu.addEventListener("click", (event) => {
      if ((event.target as HTMLElement).closest("a")) setOpen(false);
    });

    // Overlay dismissals: tap outside, or Escape.
    document.addEventListener("click", (event) => {
      const target = event.target as Node;
      if (isOpen() && !menu.contains(target) && !burger.contains(target)) {
        setOpen(false);
      }
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && isOpen()) {
        setOpen(false);
        burger.focus();
      }
    });

    // Close when the viewport grows past the collapse point.
    window.matchMedia("(min-width: 1041px)").addEventListener("change", (event) => {
      if (event.matches) setOpen(false);
    });
  }
</script>
