---
import { nextEvent } from '../../lib/events';
import { formatDateParts, todayInBerlin } from '../../lib/datetime';
import {
    localeFromAstro,
    sectionHref,
    sectionIds,
    useTranslations,
} from '../../i18n';

/**
 * The "tonight" chip in the header bar.
 *
 * Only on the night itself, and only once the hero has scrolled away: it keeps
 * the one thing that matters on that day on screen, with a way straight back to
 * the details. On every other day the bar stays quiet, because "the next one is
 * in twelve days" is not worth a permanent fixture.
 *
 * The fade is in the stylesheet, keyed off the header's scrolled state.
 *
 * Rendered from the build-time date. A page left open past midnight shows
 * yesterday here until it is reloaded, which matters far less than the date
 * list itself, and that is corrected in the browser.
 */
const locale = localeFromAstro(Astro.currentLocale);
const t = useTranslations(locale);

const today = todayInBerlin();
const event = nextEvent(today);
const isToday = event?.date === today;
const parts = event ? formatDateParts(event.date, locale) : null;
---

{
    isToday && event && parts && (
        <a
            href={sectionHref(sectionIds.dates, locale)}
            data-header-chip
            class="hidden shrink-0 items-center gap-2.5 rounded-sharp border border-orange/50 bg-orange/8 px-3 py-1.5 whitespace-nowrap text-inherit transition-colors hover:bg-orange/14 xl:flex"
        >
            <span class="mh-pulse size-1.5 shrink-0 rounded-full bg-orange" aria-hidden="true" />

            <span class="font-display text-2xs tracking-label text-cream uppercase">
                <span class="text-orange">{t.nextEvent.todayLabel}</span>
                <span class="text-gold/35"> · </span>
                <time datetime={event.date}>
                    {parts.weekday} {parts.day} {parts.month}
                </time>
            </span>
        </a>
    )
}
