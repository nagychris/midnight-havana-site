---
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import { getClass, type ClassId } from '../../data/classes';
import { bookingUrlFor, nextEvent } from '../../lib/events';
import { formatDateParts } from '../../lib/datetime';
import { site } from '../../data/site';
import {
    eventPathFor,
    localeFromAstro,
    useTranslations,
} from '../../i18n';

/**
 * "Welcher Kurs ist meiner?" — four answers, one recommended class.
 *
 * Four people out of five arrive not knowing which of the four classes they
 * belong in, and the artboard answers that before the cards rather than after
 * them. Every answer's panel is rendered here and only one is shown at a time,
 * so the copy stays in `src/i18n/` and the browser only toggles `hidden`.
 *
 * Without JavaScript the four answers are still readable as a list of classes
 * and the cards below carry the same information.
 */
const locale = localeFromAstro(Astro.currentLocale);
const t = useTranslations(locale);
const finder = t.classes.finder;

/* Least experience first, as the question is phrased. This is not the card
   order, which groups the two tracks by start time. */
const ANSWER_ORDER: ClassId[] = [
    'salsa-basics',
    'salsa-beginner',
    'rueda-beginner',
    'rueda-advanced',
];

const next = nextEvent();
const nextParts = next ? formatDateParts(next.date, locale) : null;
const nextLine =
    next && nextParts
        ? [
              `${nextParts.weekday} ${nextParts.day} ${nextParts.month}`,
              next.title?.[locale],
          ]
              .filter(Boolean)
              .join(' · ')
        : null;

const answers = ANSWER_ORDER.map((id) => ({
    id,
    danceClass: getClass(id),
    copy: finder.answers[id],
    name: t.classes.items[id].name,
    bookUrl: next ? bookingUrlFor(next, id) : site.booking.fallbackUrl,
}));
---

<div
    data-class-finder
    class="border border-gold/35 bg-surface p-5 sm:p-6"
>
    <h3 class="font-display text-h4 leading-tight-2 font-medium tracking-tiny text-cream">
        {finder.title}
    </h3>
    <p class="mt-2 text-md leading-snug-2 text-cream/70">{finder.question}</p>

    <div class="mt-4 flex flex-col gap-2">
        {
            answers.map((answer) => (
                <button
                    type="button"
                    data-finder-option={answer.id}
                    data-selected="false"
                    aria-pressed="false"
                    aria-controls={`finder-result-${answer.id}`}
                    class="min-h-13 cursor-pointer rounded-sharp border border-gold/30 px-4 py-3 text-left text-lg text-gold-light transition-colors hover:border-gold/60 data-[selected=true]:border-orange data-[selected=true]:bg-orange/16 data-[selected=true]:text-cream"
                >
                    {answer.copy.label}
                </button>
            ))
        }
    </div>

    {
        answers.map((answer) => (
            <div
                id={`finder-result-${answer.id}`}
                data-finder-result={answer.id}
                hidden
                class="mt-4 border border-orange/50 bg-orange/8 p-4 sm:p-5"
            >
                <p class="font-display text-2xs tracking-eyebrow text-orange uppercase">
                    {finder.resultLabel}
                </p>

                <h4 class="mt-2 font-display text-h4 leading-tight-2 font-medium text-cream uppercase">
                    {answer.name}
                    <span class="text-orange-light"> · </span>
                    {answer.danceClass.startTime}
                </h4>

                <p class="mt-2 text-md leading-snug-2 text-cream/75">
                    {answer.copy.why}
                </p>

                {nextLine && (
                    <p class="mt-3 font-display text-xs tracking-label text-gold uppercase">
                        {finder.nextOn} {nextLine}
                    </p>
                )}

                <div class="mt-4 flex flex-col gap-2.5">
                    <Button
                        href={answer.bookUrl}
                        external
                        fullWidth
                        data-analytics={`finder-book:${answer.id}`}
                    >
                        {finder.bookThis}
                        <Icon name="external" size={15} />
                    </Button>

                    {next && (
                        <Button
                            href={eventPathFor(next.slug, locale)}
                            variant="secondary"
                            fullWidth
                        >
                            {finder.seeNight}
                            <Icon name="arrow-right" size={15} />
                        </Button>
                    )}
                </div>

                <p class="mt-3 text-sm leading-snug-2 text-cream/60">
                    {finder.optionalNote}
                </p>
            </div>
        ))
    }

    <p class="mt-4 border border-dashed border-gold/30 p-4 text-md leading-snug-2 text-cream/75">
        <strong class="font-semibold text-gold">{finder.unsureStrong}</strong>{' '}
        {finder.unsureRest}
    </p>
</div>

<script>
    /**
     * Shows the panel for the answer that was picked, and remembers it.
     *
     * The choice is kept so someone who comes back from Eversports, or returns
     * next week, still sees their class rather than starting the question
     * again. It is a convenience, so a browser that refuses storage is fine.
     */
    const STORAGE_KEY = 'mh-class';

    const finder = document.querySelector<HTMLElement>('[data-class-finder]');

    if (finder) {
        const options = Array.from(
            finder.querySelectorAll<HTMLButtonElement>('[data-finder-option]'),
        );
        const results = Array.from(
            finder.querySelectorAll<HTMLElement>('[data-finder-result]'),
        );

        const select = (classId: string) => {
            options.forEach((option) => {
                const isChosen = option.dataset.finderOption === classId;
                option.dataset.selected = String(isChosen);
                option.setAttribute('aria-pressed', String(isChosen));
            });

            results.forEach((result) => {
                result.hidden = result.dataset.finderResult !== classId;
            });
        };

        options.forEach((option) => {
            option.addEventListener('click', () => {
                const classId = option.dataset.finderOption ?? '';
                select(classId);
                try {
                    localStorage.setItem(STORAGE_KEY, classId);
                } catch {
                    // Private mode, or storage switched off. Nothing to do.
                }
            });
        });

        try {
            const remembered = localStorage.getItem(STORAGE_KEY);
            const isKnown = options.some(
                (option) => option.dataset.finderOption === remembered,
            );
            if (remembered && isKnown) select(remembered);
        } catch {
            // Same as above.
        }
    }
</script>
