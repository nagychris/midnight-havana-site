---
import { Image } from "astro:assets";
import logo from "../assets/logo-round.png";
import Instagram from "./icons/Instagram.astro";
import Whatsapp from "./icons/Whatsapp.astro";

interface Props {
  /** Placeholder in the design (href="#") — see TASKS.md open question 3. */
  whatsappUrl?: string;
}
const { whatsappUrl = "#" } = Astro.props;

const siteLinks = [
  { href: "#dates", label: "Next dates" },
  { href: "#start", label: "New here?" },
  { href: "#courses", label: "Classes & levels" },
  { href: "#venue", label: "Venue & map" },
  { href: "#faq", label: "FAQ" },
];
---

<footer class="border-t border-gold/20 bg-ink">
  <!-- ADDED: 2 columns below 860px, 1 below 560px; the artboard had no breakpoint. -->
  <div
    class="mx-auto grid max-w-[1240px] grid-cols-[1.4fr_1fr_1fr] gap-12 px-8 pt-[70px] pb-[34px] max-md:grid-cols-2 max-xs:grid-cols-1 max-sm:px-5"
  >
    <div>
      <div class="flex items-center gap-3.5">
        <Image
          src={logo}
          alt=""
          width={156}
          format="webp"
          quality={88}
          loading="lazy"
          class="block h-[52px] w-[52px]"
        />
        <div>
          <div
            class="font-wordmark text-lg font-bold tracking-wide-16 text-cream uppercase"
          >
            Midnight Havana
          </div>
          <div
            class="font-display mt-[5px] text-2xs-plus tracking-wide-24 text-gold uppercase"
          >
            Social dance · warm nights · real connection
          </div>
        </div>
      </div>
      <p class="mt-6 max-w-[38ch] text-base-plus leading-normal-2 text-cream/45 text-pretty">
        Cuban casino and rueda de casino in Berlin-Kreuzberg. Every Friday at
        Tangoloft, Pfuelstraße 5.
      </p>
    </div>

    <div class="flex flex-col gap-3">
      <span
        class="font-display text-2xs-plus tracking-wide-24 text-cream/40 uppercase"
        >Site</span
      >
      {
        siteLinks.map((link) => (
          <a href={link.href} class="text-base-plus text-cream/70 hover:text-gold-light">
            {link.label}
          </a>
        ))
      }
    </div>

    <div class="flex flex-col gap-3">
      <span
        class="font-display text-2xs-plus tracking-wide-24 text-cream/40 uppercase"
        >Find us</span
      >
      <a
        href="https://www.instagram.com/midnight.havana/"
        target="_blank"
        rel="noopener"
        class="flex items-center gap-[9px] text-base-plus text-cream/70 hover:text-gold-light"
      >
        <Instagram size={16} />
        Instagram
      </a>
      <a
        href={whatsappUrl}
        class="flex items-center gap-[9px] text-base-plus text-cream/70 hover:text-gold-light"
      >
        <Whatsapp size={16} />
        WhatsApp community
      </a>
      <a
        href="mailto:hola@midnighthavana.de"
        class="text-base-plus text-cream/70 hover:text-gold-light">hola@midnighthavana.de</a
      >
      <a href="#" class="text-base-plus text-cream/70 hover:text-gold-light">Impressum</a>
      <a href="#" class="text-base-plus text-cream/70 hover:text-gold-light">Datenschutz</a>
    </div>
  </div>

  <div
    class="mx-auto flex max-w-[1240px] flex-wrap justify-between gap-3 border-t border-gold/12 px-8 pt-[22px] pb-10 text-sm text-cream/32 max-sm:px-5"
  >
    <span>© 2026 Midnight Havana · Berlin</span>
    <span>Cuba meets Berlin</span>
  </div>
</footer>
