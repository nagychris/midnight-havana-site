---
// The "Tonight" bar directly under the hero.
---

<div class="border-y border-gold/18 bg-ink-strip">
  <div
    class="mx-auto flex max-w-[1240px] flex-wrap items-center gap-x-[34px] gap-y-2.5 px-8 py-[22px] max-sm:px-5"
  >
    <span
      class="font-display inline-flex items-center gap-[9px] text-xs font-medium tracking-wide-22 text-orange uppercase"
    >
      <!-- Pulsing ring under a steady core — see .mh-live-* in global.css. -->
      <span class="relative flex h-[7px] w-[7px] items-center justify-center">
        <span
          class="mh-live-ring absolute h-full w-full rounded-full bg-orange"
          aria-hidden="true"></span>
        <span class="relative h-[7px] w-[7px] rounded-full bg-orange"></span>
      </span>
      <span>Tonight</span>
    </span>
    <span
      class="font-display text-2xl font-medium tracking-tight-3 text-cream uppercase"
      >Fri 21 Aug · Summer Peak Party</span
    >
    <span class="text-md-plus text-cream/60"
      >Classes 19:00 · Social 21:00 · DJ EC Kuba · Tangoloft Berlin</span
    >
    <a
      href="/event"
      class="font-display ml-auto border-b border-gold/45 pb-0.5 text-xs-plus tracking-wide-16 uppercase max-md:ml-0"
      >Event details →</a
    >
  </div>
</div>
