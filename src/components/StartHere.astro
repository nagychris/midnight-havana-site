---
// The step grid uses .mh-steps from global.css.
const steps = [
  {
    number: "01",
    title: "Just come at 18:45",
    body: "No sign-up, no partner, no email. Pay cash at the door, leave your jacket, get on the floor.",
  },
  {
    number: "02",
    title: "Take Casino Basics",
    body: "One hour, from zero: the step, the timing, how to lead and follow. We rotate partners the whole class.",
  },
  {
    number: "03",
    title: "Stay for the social",
    body: "From 21:00 the DJ takes over. Ask someone from your class to dance — that's how everyone here started.",
  },
  {
    number: "04",
    title: "Come back Friday",
    body: "After three or four nights, add the 20:00 class. That's when it stops being steps and starts being dancing.",
  },
];
---

<section id="start" class="mt-[120px] border-y border-gold/18 bg-surface">
  <div class="mx-auto max-w-[1240px] px-8 py-[104px] max-sm:px-5 max-sm:py-16">
    <div class="max-w-[60ch]">
      <span class="font-display text-xs tracking-wide-30 text-orange uppercase"
        >Never danced salsa before?</span
      >
      <h2
        class="font-display mt-4 text-h2 leading-flat-2 font-medium text-cream uppercase"
      >
        Start on any Friday.<br />Start at 19:00.
      </h2>
      <p
        class="mt-[22px] text-xl leading-normal-3 text-cream/68 text-pretty max-sm:hidden"
      >
        Every Friday stands on its own — nothing is a course you can fall behind in.
        If tonight is your first night ever, you take <strong
          class="font-semibold text-cream">Casino Basics at 19:00</strong
        >, then stay for the social dance and try it out. That's the whole plan.
      </p>
    </div>

    <div class="mh-steps mt-[58px]">
      {
        steps.map((step) => (
          <div class="bg-surface px-[30px] pt-[34px] pb-9">
            <div class="font-display text-md font-semibold tracking-wide-20 text-orange">
              {step.number}
            </div>
            <h3 class="font-display mt-4 text-5xl font-medium text-cream uppercase">
              {step.title}
            </h3>
            <p class="mt-[11px] text-md leading-normal-2 text-cream/60 text-pretty">
              {step.body}
            </p>
          </div>
        ))
      }
    </div>

    <div class="mt-11 flex flex-wrap items-center gap-3.5">
      <a
        href="#courses"
        class="font-display rounded-sharp bg-orange px-7 py-4 text-sm-plus font-medium tracking-wide-16 text-ink uppercase hover:bg-orange-hover hover:text-ink"
        >Which class is mine?</a
      >
      <span class="text-base-plus text-cream/50 max-sm:hidden"
        >One thing to bring: <strong class="font-semibold text-gold-light"
          >clean indoor shoes</strong
        > — no street shoes on the wooden floor.</span
      >
    </div>
  </div>
</section>
