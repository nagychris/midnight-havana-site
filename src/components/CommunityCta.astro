---
import Instagram from "./icons/Instagram.astro";
import Whatsapp from "./icons/Whatsapp.astro";

interface Props {
  /** Placeholder in the design (href="#") — see TASKS.md open question 3. */
  whatsappUrl?: string;
}
const { whatsappUrl = "#" } = Astro.props;

const scrim =
  "linear-gradient(90deg,rgba(11,9,8,.96) 0%,rgba(11,9,8,.86) 48%,rgba(11,9,8,.5) 100%)";
---

<section id="community" class="relative mt-[118px] overflow-hidden">
  <div class="absolute inset-0">
    <img
      src="/assets/dj-night.jpg"
      alt=""
      loading="lazy"
      class="h-full w-full object-cover"
    />
  </div>
  <div class="pointer-events-none absolute inset-0" style={`background:${scrim}`}></div>

  <div
    class="pointer-events-none relative mx-auto max-w-[1240px] px-8 py-[110px] max-sm:px-5 max-sm:py-16"
  >
    <div class="pointer-events-auto max-w-[52ch]">
      <span class="font-display text-xs tracking-wide-30 text-gold uppercase"
        >Stay in the loop</span
      >
      <h2
        class="font-display mt-4 text-h2-cta leading-flat-2 font-medium text-cream uppercase"
      >
        Every date, every special, in one place
      </h2>
      <p class="mt-5 text-lg-plus leading-normal-3 text-cream/70 text-pretty">
        The WhatsApp community is where dates, cancellations and last-minute specials
        go out first — and where people find each other for the ride home. Instagram
        is where the photos land.
      </p>
      <div class="mt-[34px] flex flex-wrap gap-3.5">
        <a
          href="https://www.instagram.com/midnight.havana/"
          target="_blank"
          rel="noopener"
          class="font-display flex items-center gap-[11px] rounded-sharp bg-orange px-[30px] py-[17px] text-sm-plus font-medium tracking-wide-16 text-ink uppercase hover:bg-orange-hover hover:text-ink"
        >
          <Instagram />
          Follow @midnight.havana
        </a>
        <a
          href={whatsappUrl}
          class="font-display flex items-center gap-[11px] rounded-sharp border border-gold/50 px-[30px] py-[17px] text-sm-plus font-medium tracking-wide-16 text-gold-light uppercase hover:bg-gold/12 hover:text-cream"
        >
          <Whatsapp />
          Join the WhatsApp community
        </a>
      </div>
    </div>
  </div>
</section>
