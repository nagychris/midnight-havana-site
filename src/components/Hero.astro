---
// Both scrims are the artboard's; dropping either washes the headline out.
const scrimHorizontal =
  "linear-gradient(95deg,rgba(11,9,8,.95) 0%,rgba(11,9,8,.9) 30%,rgba(11,9,8,.62) 50%,rgba(11,9,8,.22) 78%,rgba(11,9,8,.1) 100%)";
const scrimVertical =
  "linear-gradient(to top,rgba(11,9,8,.96) 0%,rgba(11,9,8,.6) 30%,rgba(11,9,8,.25) 62%,rgba(11,9,8,.5) 100%)";
---

<section
  id="top"
  class="relative flex flex-1 items-end overflow-hidden min-h-[420px]"
>
  <div class="absolute inset-0">
    <img
      src="/assets/hero-social.jpg"
      alt="A packed floor at Salsa Friday, warm light, dancers mid-turn"
      class="h-full w-full object-cover"
      fetchpriority="high"
    />
  </div>

  <div
    class="pointer-events-none absolute inset-0"
    style={`background:${scrimHorizontal},${scrimVertical}`}
  >
  </div>

  <div
    class="pointer-events-none relative mx-auto w-full max-w-[1240px] px-8 pb-[78px] [text-shadow:0_1px_24px_rgba(11,9,8,.85)] max-sm:px-5 max-sm:pb-9"
  >
    <div class="pointer-events-auto mb-[22px]">
      <span
        class="font-display text-xs-plus font-normal tracking-wide-30 text-gold uppercase"
        >Berlin · Kreuzberg · Every Friday</span
      >
    </div>

    <h1>
      <span
        class="font-display block text-hero-line leading-crush font-semibold tracking-tightest text-cream uppercase"
        >Salsa Friday</span
      >
      <!-- text-shadow cleared: the glyphs are transparent for the gradient. -->
      <span
        class="font-display mt-1.5 block bg-gradient-to-r from-orange via-[#e0842f] to-[#f0c46a] bg-clip-text text-hero-line leading-crush font-semibold tracking-tightest text-transparent uppercase [text-shadow:none]"
        >Come to learn. Stay to dance.</span
      >
    </h1>

    <p class="mt-8 max-w-[52ch] text-xl leading-relaxed-2 text-cream/62 text-pretty">
      Cuban casino and rueda, taught from the first step. Classes at 19:00, social
      dance from 21:00 — no partner or sign-up needed.
    </p>

    <div class="pointer-events-auto mt-9 flex flex-wrap gap-3.5">
      <a
        href="#start"
        class="font-display rounded-sharp bg-orange px-[30px] py-[17px] text-base font-medium tracking-wide-16 text-ink uppercase hover:bg-orange-hover hover:text-ink"
        >New? Start here</a
      >
      <a
        href="#dates"
        class="font-display rounded-sharp border border-gold/50 px-[30px] py-[17px] text-base font-medium tracking-wide-16 text-gold-light uppercase hover:bg-gold/12 hover:text-cream"
        >Next dates</a
      >
    </div>
  </div>
</section>
