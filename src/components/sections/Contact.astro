---
import Section from '../ui/Section.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import Button from '../ui/Button.astro';
import { site } from '../../data/site';
import {
    localeFromAstro,
    pathFor,
    sectionIds,
    useTranslations,
} from '../../i18n';

/**
 * Contact, following the artboard.
 *
 * The form has no backend. Submitting builds a `mailto:` link and hands the
 * message to whatever mail app the visitor uses, so nothing is stored here and
 * the reply lands in a normal inbox. The e-mail address is spelled out under
 * the form as well, for anyone whose phone has no mail account set up.
 */
const locale = localeFromAstro(Astro.currentLocale);
const t = useTranslations(locale);

const fieldClass =
    'h-13 w-full rounded-sharp border border-gold/35 bg-surface px-4 text-lg text-cream placeholder:text-cream/45';
---

<Section id={sectionIds.contact} divider labelledBy="contact-heading">
    <div class="grid gap-10 lg:grid-cols-2 lg:gap-16">
        <SectionHeading
            eyebrow={t.contact.eyebrow}
            headline={t.contact.headline}
            id="contact-heading"
        >
            {t.contact.intro}
        </SectionHeading>

        <div>
            <form
                data-contact-form
                data-mail-to={site.email}
                data-subject={t.contact.subject}
                class="flex flex-col gap-3"
            >
                <div class="grid gap-3 sm:grid-cols-2">
                    <div>
                        <label class="sr-only" for="contact-name">
                            {t.contact.name}
                        </label>
                        <input
                            id="contact-name"
                            name="name"
                            required
                            autocomplete="name"
                            placeholder={t.contact.name}
                            class={fieldClass}
                        />
                    </div>
                    <div>
                        <label class="sr-only" for="contact-phone">
                            {t.contact.phone}
                        </label>
                        <input
                            id="contact-phone"
                            name="phone"
                            type="tel"
                            autocomplete="tel"
                            placeholder={t.contact.phone}
                            class={fieldClass}
                        />
                    </div>
                </div>

                <label class="sr-only" for="contact-email">
                    {t.contact.email}
                </label>
                <input
                    id="contact-email"
                    name="email"
                    type="email"
                    required
                    autocomplete="email"
                    placeholder={t.contact.email}
                    class={fieldClass}
                />

                <label class="sr-only" for="contact-message">
                    {t.contact.message}
                </label>
                <textarea
                    id="contact-message"
                    name="message"
                    required
                    rows="5"
                    placeholder={t.contact.message}
                    class="w-full resize-y rounded-sharp border border-gold/35 bg-surface p-4 text-lg text-cream placeholder:text-cream/45"
                ></textarea>

                <Button type="submit" size="lg" fullWidth class="mt-1">
                    {t.contact.send}
                </Button>
            </form>

            <p class="mt-5 text-md leading-snug-2 text-cream/70">
                {t.contact.orWrite}{' '}
                <a href={`mailto:${site.email}`}>{site.email}</a>
            </p>
            <p class="mt-2 text-sm text-cream/50">{t.contact.hint}</p>
            <p class="mt-2 text-sm leading-snug-2 text-cream/50">
                {t.contact.privacyIntro}
                <a href={pathFor('privacy', locale)}>{t.contact.privacyLink}</a>.
            </p>
        </div>
    </div>
</Section>

<script>
    /**
     * Hands the message to the visitor's mail app.
     *
     * Without this the form would post to the current URL and lose the message,
     * so the handler is what makes it work at all. The browser still runs its
     * own validation first, because `submit` does not fire on an invalid form.
     */
    const form = document.querySelector<HTMLFormElement>('[data-contact-form]');

    form?.addEventListener('submit', (event) => {
        event.preventDefault();

        const data = new FormData(form);
        const value = (field: string) => String(data.get(field) ?? '').trim();

        const lines = [
            `Name: ${value('name')}`,
            `Telefon: ${value('phone')}`,
            `E-Mail: ${value('email')}`,
            '',
            value('message'),
        ];

        const address = form.dataset.mailTo ?? '';
        const subject = encodeURIComponent(form.dataset.subject ?? '');
        const body = encodeURIComponent(lines.join('\n'));

        window.location.href = `mailto:${address}?subject=${subject}&body=${body}`;
    });
</script>
