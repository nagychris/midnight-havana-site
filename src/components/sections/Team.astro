---
import { Image } from 'astro:assets';
import Section from '../ui/Section.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import Zoomable from '../ui/Zoomable.astro';
import { site } from '../../data/site';
import { photoByName } from '../../data/photos';
import { localeFromAstro, sectionIds, useTranslations } from '../../i18n';

/**
 * The teachers.
 *
 * A portrait is looked up by name, `teacher-helen.jpg` and so on. A card with
 * no photo file simply starts at the name: an empty frame or a stand-in letter
 * only draws attention to what is missing.
 */
const locale = localeFromAstro(Astro.currentLocale);
const t = useTranslations(locale);

const members = t.team.members.map((member) => ({
    ...member,
    photo: photoByName(`teacher-${member.name.toLowerCase()}.jpg`),
}));
---

<Section id={sectionIds.team} divider labelledBy="team-heading">
    <SectionHeading
        eyebrow={t.team.eyebrow}
        headline={t.team.headline}
        id="team-heading"
        split
    >
        <span class="block">{t.team.intro1}</span>
        <span class="mt-3 block">{t.team.intro2}</span>
    </SectionHeading>

    <ul class="mt-12 grid gap-4 md:grid-cols-3" data-lightbox-gallery>
        {
            members.map((member) => (
                <li class="flex flex-col border border-gold/25 bg-surface">
                    {member.photo && (
                        <Zoomable photo={member.photo}>
                            <Image
                                src={member.photo.image}
                                alt={`${member.name} — ${member.role}`}
                                widths={[320, 480, 720]}
                                sizes="(min-width: 768px) 30vw, 100vw"
                                format="webp"
                                quality={80}
                                loading="lazy"
                                decoding="async"
                                class:list={[
                                    'aspect-4/5 w-full object-cover',
                                    member.photo.focus,
                                ]}
                            />
                        </Zoomable>
                    )}

                    <div class="flex flex-1 flex-col p-5 sm:p-6">
                        <h3 class="font-display text-h3 leading-tight-2 font-semibold tracking-tiny text-cream uppercase">
                            {member.name}
                        </h3>
                        <p class="mt-1.5 font-display text-sm tracking-label text-gold uppercase">
                            {member.role}
                        </p>

                        <div class="mt-4 flex flex-col gap-3 text-md leading-snug-2 text-cream/70">
                            {member.body.map((paragraph) => (
                                <p>{paragraph}</p>
                            ))}
                        </div>

                        <p class="mt-auto border-t border-gold/20 pt-4 font-display text-md leading-snug-2 tracking-tiny text-gold">
                            <span class="sr-only">{t.team.mottoLabel}: </span>
                            {member.motto}
                        </p>
                    </div>
                </li>
            ))
        }
    </ul>

    <Button
        href={site.school.url}
        external
        variant="secondary"
        size="lg"
        class="mt-12"
    >
        {t.team.cta}
        <Icon name="external" size={16} />
    </Button>
</Section>
