---
import { Image } from 'astro:assets';
import Section from '../ui/Section.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import { site } from '../../data/site';
import { photoByName } from '../../data/photos';
import { localeFromAstro, sectionIds, useTranslations } from '../../i18n';

/**
 * The teachers.
 *
 * A portrait is looked up by name, `teacher-helen.jpg` and so on. Until those
 * files land in src/assets/photos/ the card shows the initial in the brand
 * type, which reads as a deliberate choice rather than a missing image.
 */
const locale = localeFromAstro(Astro.currentLocale);
const t = useTranslations(locale);

const members = t.team.members.map((member) => ({
    ...member,
    photo: photoByName(`teacher-${member.name.toLowerCase()}.jpg`),
}));
---

<Section id={sectionIds.team} divider labelledBy="team-heading">
    <SectionHeading
        eyebrow={t.team.eyebrow}
        headline={t.team.headline}
        id="team-heading"
        split
    >
        <span class="block">{t.team.intro1}</span>
        <span class="mt-3 block">{t.team.intro2}</span>
    </SectionHeading>

    <ul class="mt-12 grid gap-10 md:grid-cols-3 md:gap-8">
        {
            members.map((member) => (
                <li class="flex flex-col">
                    {member.photo ? (
                        <Image
                            src={member.photo.image}
                            alt={`${member.name} — ${member.role}`}
                            widths={[320, 480, 720]}
                            sizes="(min-width: 768px) 30vw, 100vw"
                            format="webp"
                            quality={80}
                            loading="lazy"
                            decoding="async"
                            class="aspect-4/5 w-full border border-gold/20 object-cover"
                        />
                    ) : (
                        <div
                            class="flex aspect-4/5 w-full items-center justify-center border border-gold/20 bg-surface"
                            aria-hidden="true"
                        >
                            <span class="font-display text-hero leading-flat font-semibold text-gold/25">
                                {member.name.slice(0, 1)}
                            </span>
                        </div>
                    )}

                    <h3 class="mt-5 font-display text-h3 leading-tight-2 font-medium tracking-tiny text-cream uppercase">
                        {member.name}
                    </h3>
                    <p class="mt-1.5 font-display text-sm tracking-label text-gold uppercase">
                        {member.role}
                    </p>

                    <div class="mt-4 flex flex-col gap-3 text-md leading-snug-2 text-cream/70">
                        {member.body.map((paragraph) => (
                            <p>{paragraph}</p>
                        ))}
                    </div>

                    <p class="mt-4 border-t border-gold/15 pt-4 font-display text-md tracking-tiny text-orange-light">
                        <span class="sr-only">{t.team.mottoLabel}: </span>
                        {member.motto}
                    </p>
                </li>
            ))
        }
    </ul>

    <Button
        href={site.school.url}
        external
        variant="secondary"
        size="lg"
        class="mt-12"
    >
        {t.team.cta}
        <Icon name="external" size={16} />
    </Button>
</Section>
