---
import { Image } from 'astro:assets';
import Section from '../ui/Section.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import MapEmbed from '../MapEmbed.astro';
import { site } from '../../data/site';
import { photoGroups, photoSet } from '../../data/photos';
import { localeFromAstro, sectionIds, useTranslations } from '../../i18n';

const locale = localeFromAstro(Astro.currentLocale);
const t = useTranslations(locale);
const venuePhotos = photoSet(photoGroups.venue);
---

<Section id={sectionIds.venue} divider labelledBy="venue-heading">
    <div class="grid gap-10 lg:grid-cols-2 lg:gap-16">
        <div>
            <SectionHeading
                eyebrow={t.venue.eyebrow}
                headline={t.venue.headline}
                id="venue-heading"
            />

            <div class="mt-6 flex flex-col gap-4 text-lead leading-relaxed-2 text-cream/75">
                <p>{t.venue.body1}</p>
                <p>{t.venue.body2}</p>
            </div>

            <div class="mt-8">
                <h3 class="font-display text-xs tracking-eyebrow text-gold uppercase">
                    {t.venue.addressLabel}
                </h3>
                <address class="mt-3 text-lead leading-snug-2 text-cream not-italic">
                    <strong class="font-semibold">{site.venue.name}</strong><br />
                    {site.venue.street}<br />
                    {site.venue.postalCode} {site.venue.city}
                </address>
            </div>

            <div class="mt-8">
                <h3 class="font-display text-xs tracking-eyebrow text-gold uppercase">
                    {t.venue.directionsLabel}
                </h3>
                <ul class="mt-3 flex flex-col gap-2">
                    {
                        t.venue.transit.map((line) => (
                            <li class="flex items-start gap-2.5 text-md text-cream/75">
                                <span class="mt-0.5 text-gold" aria-hidden="true">
                                    <Icon name="map-pin" size={16} />
                                </span>
                                {line}
                            </li>
                        ))
                    }
                </ul>
                <p class="mt-3 text-sm text-cream/55">{t.venue.accessNote}</p>
            </div>

            <Button
                href={site.venue.mapsUrl}
                external
                variant="secondary"
                size="lg"
                class="mt-8"
            >
                {t.venue.cta}
                <Icon name="external" size={16} />
            </Button>

            <div class="mt-10">
                <h3 class="font-display text-xs tracking-eyebrow text-gold uppercase">
                    {t.venue.goodToKnow.heading}
                </h3>

                {/* The one rule the venue actually enforces, so it gets a box
                    of its own rather than a bullet among four. */}
                <p
                    class="mt-4 flex items-start gap-3 border border-dashed border-gold/35 p-4 text-md leading-snug-2 text-cream/80"
                >
                    <span class="mt-0.5 shrink-0 text-gold-light" aria-hidden="true">
                        <Icon name="check" size={18} />
                    </span>
                    <span>
                        {t.venue.goodToKnow.shoeLead}{' '}
                        <strong class="font-semibold text-cream">
                            {t.venue.goodToKnow.shoeStrong}
                        </strong>{' '}
                        {t.venue.goodToKnow.shoeRest}
                    </span>
                </p>

                <ul class="mt-4 grid gap-2.5 sm:grid-cols-2 sm:gap-x-6">
                    {
                        t.venue.goodToKnow.items.map((item) => (
                            <li class="flex items-start gap-2.5 text-md leading-snug-2 text-cream/70">
                                <span class="mt-0.5 shrink-0 text-green" aria-hidden="true">
                                    <Icon name="check" size={15} />
                                </span>
                                {item}
                            </li>
                        ))
                    }
                </ul>
            </div>
        </div>

        <div class="flex flex-col gap-4">
            <MapEmbed />

            {
                venuePhotos.length > 0 && (
                    <ul class="grid grid-cols-2 gap-4">
                        {venuePhotos.map((photo) => (
                            <li>
                                <Image
                                    src={photo.image}
                                    alt={photo.alt[locale]}
                                    widths={[320, 480, 720]}
                                    sizes="(min-width: 1024px) 23vw, 46vw"
                                    format="webp"
                                    quality={76}
                                    loading="lazy"
                                    decoding="async"
                                    class="aspect-4/3 w-full border border-gold/20 object-cover"
                                />
                            </li>
                        ))}
                    </ul>
                )
            }
        </div>
    </div>
</Section>
