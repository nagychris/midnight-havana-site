---
import { Image } from 'astro:assets';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import Wordmark from '../brand/Wordmark.astro';
import Logo from '../brand/Logo.astro';
import { photoGroups, photoSetOrAll } from '../../data/photos';
import { site } from '../../data/site';
import { upcomingEvents } from '../../lib/events';
import { formatDateParts, todayInBerlin } from '../../lib/datetime';
import type { SiteEvent } from '../../lib/event-types';
import {
    localeFromAstro,
    pathFor,
    sectionHref,
    sectionIds,
    useTranslations,
} from '../../i18n';

/**
 * The hero, following the artboard: a slow photo slideshow, the brand lockup
 * centred at the top, and everything else weighted to the bottom edge.
 *
 * The section is pulled up under the sticky header so the photograph runs to
 * the top of the window, which is what makes the transparent header work. The
 * header's height is added back as padding.
 *
 * Height is `100svh`. `100vh` on a phone sits behind mobile Safari's toolbar
 * and pushes the buttons out of reach.
 */
const locale = localeFromAstro(Astro.currentLocale);
const t = useTranslations(locale);
const slides = photoSetOrAll(photoGroups.hero);

/* The next few dates, each as its own line. Only the first is shown; the
   others wait in case the page is still cached after that night has passed,
   when `refreshEventDates` (src/scripts/event-freshness.ts) moves on to the
   next one. */
const today = todayInBerlin();
const heroDates = upcomingEvents(today)
    .filter((event) => !event.cancelled)
    .slice(0, 4);

/** "Kurse ab 19:00", or the first extra's start time on a workshop night. */
function startLabel(event: SiteEvent): string | null {
    if (event.regularClasses) {
        return `${t.hero.classesFrom} ${site.schedule.firstClass}`;
    }
    const first = event.extras
        .map((extra) => extra.startTime)
        .filter((time) => time < site.schedule.socialDance)
        .sort()[0];
    return first ? `${t.hero.startFrom} ${first}` : null;
}
---

<section id={sectionIds.top} class="hero relative flex flex-col overflow-hidden">
    <div class="absolute inset-0" data-hero-slides aria-hidden="true">
        {
            slides.map((photo, index) => (
                <div
                    class="hero-slide"
                    data-active={index === 0 ? 'true' : 'false'}
                >
                    <Image
                        src={photo.image}
                        alt=""
                        widths={[640, 960, 1280, 1920, 2560]}
                        sizes="100vw"
                        format="webp"
                        quality={72}
                        loading={index === 0 ? 'eager' : 'lazy'}
                        fetchpriority={index === 0 ? 'high' : 'auto'}
                        decoding={index === 0 ? 'sync' : 'async'}
                    />
                </div>
            ))
        }
    </div>

    <div class="hero-scrim pointer-events-none absolute inset-0"></div>

    <div
        class="hero-content relative mx-auto flex w-full max-w-(--container-content) flex-1 flex-col px-5.5 pb-5.5 sm:px-8 sm:pb-10"
    >
        <div class="mh-rise flex flex-col items-center gap-3">
            <Logo size={58} loading="eager" />
            <Wordmark
                class="w-[238px] max-w-[64vw] text-cream sm:w-60 lg:w-[19rem]"
                title="Midnight Havana"
            />
        </div>

        <div
            class="mt-auto pt-10 [text-shadow:0_1px_22px_rgba(11,9,8,.9)] sm:pt-14"
        >
            {/* The wordmark is directly above this and the sections below say
                it again, so on a phone the line is spent for nothing. It
                returns as soon as there is height to spare. */}
{/* The next date, so the first thing a visitor learns is when. On the
                night itself it turns orange and says "heute Abend". The dot and
                wording switch in the browser via `refreshEventBadges`. */}
            {
                heroDates.map((event, index) => {
                    const parts = formatDateParts(event.date, locale);
                    const start = startLabel(event);
                    return (
                        <p
                            data-hero-date
                            data-event-when
                            data-event-date={event.date}
                            data-today={String(event.date === today)}
                            hidden={index !== 0}
                            class="group mh-rise [animation-delay:50ms] flex flex-wrap items-center gap-x-2 gap-y-1 font-display text-xs tracking-label text-gold uppercase sm:text-sm sm:tracking-eyebrow"
                        >
                            <span
                                class="mh-pulse size-2 shrink-0 rounded-full bg-orange group-data-[today=false]:hidden"
                                aria-hidden="true"
                            />
                            <span
                                class="size-2 shrink-0 rounded-full bg-gold group-data-[today=true]:hidden"
                                aria-hidden="true"
                            />
                            <span class="hidden text-gold/80 group-data-[today=true]:hidden sm:inline">
                                {t.hero.nextLabel}:
                            </span>
                            <time
                                datetime={event.date}
                                class="font-semibold text-cream group-data-[today=true]:hidden"
                            >
                                {parts.weekday} {parts.day} {parts.month}
                            </time>
                            <span class="font-semibold text-orange group-data-[today=false]:hidden">
                                {t.nextEvent.todayLabel}
                            </span>
                            {start && (
                                <>
                                    <span class="text-gold/40" aria-hidden="true">·</span>
                                    <span>{start}</span>
                                </>
                            )}
                            <span class="text-gold/40" aria-hidden="true">·</span>
                            <span>{t.hero.partyFrom} {site.schedule.socialDance}</span>
                        </p>
                    );
                })
            }

            {/* Shown when no date is planned, or every planned one has passed. */}
            <p
                data-hero-date-fallback
                hidden={heroDates.length > 0}
                class="mh-rise [animation-delay:50ms] flex items-center gap-3 font-display text-xs tracking-eyebrow text-gold uppercase sm:text-sm"
            >
                <span class="h-px w-6 shrink-0 bg-gold" aria-hidden="true"
                ></span>
                {t.hero.eyebrowDisplay}
            </p>

            <h1
                class="mh-rise [animation-delay:180ms] max-w-[18ch] font-display text-hero leading-crush font-semibold tracking-tightest text-cream uppercase mt-3 sm:mt-4"
            >
                {t.hero.headline}
            </h1>

            {/* Hidden on phones: the date line above and the badges below say
                what a visitor needs, and the two lines are better spent
                keeping the buttons in reach. */}
            <p
                class="mh-rise [animation-delay:260ms] hidden text-balance text-lg leading-snug-2 font-normal text-orange-light sm:mt-3.5 sm:block sm:text-2xl"
            >
                {t.hero.tagline}
            </p>

            <p
                class="mh-rise [animation-delay:370ms] mt-3 flex flex-wrap items-center gap-x-2 gap-y-1 font-display text-3xs tracking-label text-gold uppercase sm:gap-x-2.5 sm:text-xs sm:tracking-label-wide"
            >
                {
                    t.hero.badges.map((badge, index) => (
                        <>
                            {index > 0 && (
                                <span class="text-gold/40" aria-hidden="true">
                                    ·
                                </span>
                            )}
                            <span>{badge}</span>
                        </>
                    ))
                }
            </p>

            <div
                class="mh-rise [animation-delay:440ms] mt-5 flex flex-col items-stretch gap-3 sm:mt-6 sm:flex-row sm:flex-wrap sm:items-center sm:gap-x-7"
            >
                <Button href={sectionHref(sectionIds.dates, locale)} size="lg">
                    {t.hero.ctaPrimary}
                    <Icon name="arrow-right" size={17} />
                </Button>

                <a
                    href={pathFor('classes', locale)}
                    class="mh-nav-link inline-flex min-h-11 items-center justify-center font-display text-sm tracking-label text-cream uppercase sm:justify-start"
                >
                    {t.hero.ctaSecondary}
                </a>
            </div>
        </div>
    </div>

    <a
        href={sectionHref(sectionIds.dates, locale)}
        aria-label={t.hero.scrollCue}
        class="mh-nudge relative mx-auto mb-5 flex size-10 shrink-0 items-center justify-center rounded-full border border-gold-light/40 text-gold-light"
    >
        <Icon name="chevron-down" size={16} />
    </a>
</section>

<script>
    /**
     * Cross-fades the hero slides.
     *
     * Paused while the tab is hidden and switched off entirely for anyone who
     * asked for reduced motion, in which case the first photo simply stays.
     */
    const SLIDE_DURATION_MS = 7000;

    const container = document.querySelector<HTMLElement>('[data-hero-slides]');
    const slides = container
        ? Array.from(container.querySelectorAll<HTMLElement>('.hero-slide'))
        : [];

    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

    if (slides.length > 1 && !reducedMotion.matches) {
        let current = 0;
        let timer = 0;

        const show = (index: number) => {
            slides[current].dataset.active = 'false';
            current = index;
            slides[current].dataset.active = 'true';
        };

        const start = () => {
            if (timer) return;
            timer = window.setInterval(
                () => show((current + 1) % slides.length),
                SLIDE_DURATION_MS
            );
        };

        const stop = () => {
            window.clearInterval(timer);
            timer = 0;
        };

        document.addEventListener('visibilitychange', () => {
            if (document.hidden) stop();
            else start();
        });

        // Only run while the hero is on screen, so a visitor who lands deeper
        // down the page does not pay for images they never see.
        if ('IntersectionObserver' in window && container) {
            const observer = new IntersectionObserver((entries) => {
                entries.forEach((entry) =>
                    entry.isIntersecting ? start() : stop()
                );
            });
            observer.observe(container);
        } else {
            start();
        }
    }
</script>
