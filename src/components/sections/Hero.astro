---
import { Image } from 'astro:assets';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import Wordmark from '../brand/Wordmark.astro';
import Logo from '../brand/Logo.astro';
import { photoGroups, photoSetOrAll } from '../../data/photos';
import {
    localeFromAstro,
    pathFor,
    sectionHref,
    sectionIds,
    useTranslations,
} from '../../i18n';

/**
 * The hero, following the artboard: a slow photo slideshow, the brand lockup
 * centred at the top, and everything else weighted to the bottom edge.
 *
 * The section is pulled up under the sticky header so the photograph runs to
 * the top of the window, which is what makes the transparent header work. The
 * header's height is added back as padding.
 *
 * Height is `100svh`. `100vh` on a phone sits behind mobile Safari's toolbar
 * and pushes the buttons out of reach.
 */
const locale = localeFromAstro(Astro.currentLocale);
const t = useTranslations(locale);
const slides = photoSetOrAll(photoGroups.hero);

/* Both scrims are from the artboard. Dropping either washes the text out. */
const scrimVertical =
    'linear-gradient(to top, rgba(11,9,8,.96) 0%, rgba(11,9,8,.62) 34%, rgba(11,9,8,.28) 64%, rgba(11,9,8,.55) 100%)';
const scrimHorizontal =
    'linear-gradient(100deg, rgba(11,9,8,.85) 0%, rgba(11,9,8,.5) 45%, rgba(11,9,8,.12) 100%)';
---

<section
    id={sectionIds.top}
    class="relative flex flex-col overflow-hidden"
    style="margin-top: calc(-1 * var(--header-height)); min-height: max(35rem, 100svh)"
>
    <div class="absolute inset-0" data-hero-slides aria-hidden="true">
        {
            slides.map((photo, index) => (
                <div
                    class="hero-slide"
                    data-active={index === 0 ? 'true' : 'false'}
                >
                    <Image
                        src={photo.image}
                        alt=""
                        widths={[640, 960, 1280, 1920, 2560]}
                        sizes="100vw"
                        format="webp"
                        quality={72}
                        loading={index === 0 ? 'eager' : 'lazy'}
                        fetchpriority={index === 0 ? 'high' : 'auto'}
                        decoding={index === 0 ? 'sync' : 'async'}
                    />
                </div>
            ))
        }
    </div>

    <div
        class="pointer-events-none absolute inset-0"
        style={`background:${scrimHorizontal},${scrimVertical}`}
    >
    </div>

    <div
        class="relative mx-auto flex w-full max-w-(--container-content) flex-1 flex-col px-5.5 pb-5.5 sm:px-8 sm:pb-10"
        style="padding-top: calc(var(--header-height) + 1.5rem)"
    >
        <div class="mh-rise flex flex-col items-center gap-3">
            <Logo size={58} loading="eager" class="sm:hidden" />
            <Logo size={58} loading="eager" class="hidden sm:block" />
            <Wordmark
                class="w-[238px] max-w-[64vw] text-cream sm:w-60 lg:w-[19rem]"
                title="Midnight Havana"
            />
        </div>

        <div
            class="mt-auto pt-10 [text-shadow:0_1px_22px_rgba(11,9,8,.9)] sm:pt-14"
        >
            <p
                class="mh-rise flex items-center gap-3 font-display text-xs tracking-eyebrow text-gold uppercase sm:text-sm"
                style="animation-delay:.05s"
            >
                <span class="h-px w-6 shrink-0 bg-gold" aria-hidden="true"
                ></span>
                {t.hero.eyebrowDisplay}
            </p>

            <h1
                class="mh-rise mt-3 max-w-[18ch] font-display text-hero leading-crush font-semibold tracking-tightest text-cream uppercase sm:mt-4"
                style="animation-delay:.18s"
            >
                {t.hero.headline}
            </h1>

            <p
                class="mh-rise mt-2.5 max-w-[52ch] text-lg leading-snug-2 font-normal text-orange-light sm:mt-3.5 sm:text-2xl"
                style="animation-delay:.26s"
            >
                {t.hero.tagline}
            </p>

            {
                /* The full pitch. On a phone the buttons matter more, so it is
                kept for larger screens and for search engines. */
            }
            {/* Every fact in this sentence is repeated by the sections below,
                so on a phone it is three lines of prose between the promise and
                the button. Kept in the markup, shown where there is room. */}
            <p
                class="mh-rise mt-3.5 hidden max-w-[58ch] text-lead leading-snug-2 text-cream/75 lg:block"
                style="animation-delay:.31s"
            >
                {t.hero.body}
            </p>

            <p
                class="mh-rise mt-3.5 flex flex-wrap items-center gap-x-2 gap-y-1 font-display text-3xs tracking-label text-gold uppercase sm:gap-x-2.5 sm:text-xs sm:tracking-label-wide"
                style="animation-delay:.37s"
            >
                {
                    t.hero.badges.map((badge, index) => (
                        <>
                            {index > 0 && (
                                <span class="text-gold/40" aria-hidden="true">
                                    ·
                                </span>
                            )}
                            <span>{badge}</span>
                        </>
                    ))
                }
            </p>

            <div
                class="mh-rise mt-5 flex flex-col items-stretch gap-3 sm:mt-6 sm:flex-row sm:flex-wrap sm:items-center sm:gap-x-7"
                style="animation-delay:.44s"
            >
                <Button href={sectionHref(sectionIds.dates, locale)} size="lg">
                    {t.hero.ctaPrimary}
                    <Icon name="arrow-right" size={17} />
                </Button>

                <a
                    href={pathFor('classes', locale)}
                    class="mh-nav-link inline-flex min-h-11 items-center justify-center font-display text-sm tracking-label text-cream uppercase sm:justify-start"
                >
                    {t.hero.ctaSecondary}
                </a>
            </div>
        </div>
    </div>

    <a
        href={sectionHref(sectionIds.dates, locale)}
        aria-label={t.hero.scrollCue}
        class="mh-nudge relative mx-auto mb-5 flex size-10 shrink-0 items-center justify-center rounded-full border border-gold-light/40 text-gold-light"
    >
        <Icon name="chevron-down" size={16} />
    </a>
</section>

<script>
    /**
     * Cross-fades the hero slides.
     *
     * Paused while the tab is hidden and switched off entirely for anyone who
     * asked for reduced motion, in which case the first photo simply stays.
     */
    const SLIDE_DURATION_MS = 7000;

    const container = document.querySelector<HTMLElement>('[data-hero-slides]');
    const slides = container
        ? Array.from(container.querySelectorAll<HTMLElement>('.hero-slide'))
        : [];

    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

    if (slides.length > 1 && !reducedMotion.matches) {
        let current = 0;
        let timer = 0;

        const show = (index: number) => {
            slides[current].dataset.active = 'false';
            current = index;
            slides[current].dataset.active = 'true';
        };

        const start = () => {
            if (timer) return;
            timer = window.setInterval(
                () => show((current + 1) % slides.length),
                SLIDE_DURATION_MS
            );
        };

        const stop = () => {
            window.clearInterval(timer);
            timer = 0;
        };

        document.addEventListener('visibilitychange', () => {
            if (document.hidden) stop();
            else start();
        });

        // Only run while the hero is on screen, so a visitor who lands deeper
        // down the page does not pay for images they never see.
        if ('IntersectionObserver' in window && container) {
            const observer = new IntersectionObserver((entries) => {
                entries.forEach((entry) =>
                    entry.isIntersecting ? start() : stop()
                );
            });
            observer.observe(container);
        } else {
            start();
        }
    }
</script>
