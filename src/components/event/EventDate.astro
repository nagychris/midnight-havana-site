---
import { formatDateParts } from '../../lib/datetime';
import { localeFromAstro } from '../../i18n';

/**
 * The large date block: weekday, day number, month.
 *
 * Wrapped in a `<time>` so the machine-readable date sits next to the display
 * one, which matters for both accessibility and structured data.
 */
interface Props {
    date: string;
    /** Highlights the date in the accent colour. */
    accent?: boolean;
    size?: 'md' | 'lg';
    class?: string;
}

const { date, accent = false, size = 'lg', class: className } = Astro.props;

const locale = localeFromAstro(Astro.currentLocale);
const parts = formatDateParts(date, locale);
---

<time
    datetime={date}
    class:list={[
        'flex items-baseline gap-2 text-left sm:block sm:text-center',
        className,
    ]}
>
    <span
        class:list={[
            'font-display text-sm font-light tracking-label-wide uppercase',
            accent ? 'text-orange' : 'text-gold/75',
        ]}
    >
        {parts.weekday}
    </span>
    <span
        class:list={[
            'block font-display leading-flat font-semibold text-cream',
            size === 'lg' ? 'text-date' : 'text-h3',
        ]}
    >
        {parts.day}
    </span>
    <span
        class="font-display text-sm tracking-label text-cream/65 uppercase sm:block"
    >
        {parts.month}
        <span class="sm:hidden">{parts.year}</span>
    </span>
    <span class="hidden font-display text-xs tracking-label text-cream/40 uppercase sm:block">
        {parts.year}
    </span>
</time>
