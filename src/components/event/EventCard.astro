---
import Badge from '../ui/Badge.astro';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import EventDate from './EventDate.astro';
import EventSchedule from './EventSchedule.astro';
import { site } from '../../data/site';
import {
    bookingUrlFor,
    hasSpecificBookingLinks,
    type SiteEvent,
} from '../../lib/events';
import { formatLongDate } from '../../lib/datetime';
import {
    eventPathFor,
    localeFromAstro,
    useTranslations,
} from '../../i18n';

/**
 * One event date, with its timetable and its four booking links.
 *
 * A `<details>` element: the next date is open, the ones after it are collapsed
 * so the section stays scannable. Using the native element means the toggle
 * works with the keyboard and without JavaScript, and the collapsed content is
 * still in the HTML for a search engine to read.
 *
 * `data-event-date` lets the freshness script find and hide a date that has
 * passed since the site was last built.
 */
interface Props {
    event: SiteEvent;
    /** True for the date this page considers next at build time. */
    isNext: boolean;
    /** True when the next date is today. */
    isToday?: boolean;
}

const { event, isNext, isToday = false } = Astro.props;

const locale = localeFromAstro(Astro.currentLocale);
const t = useTranslations(locale);

const longDate = formatLongDate(event.date, locale);
const heading = event.title?.[locale] ?? longDate;
const headingId = `event-${event.date}`;
---

<details
    id={event.date}
    class="group border border-gold/25 bg-surface/40 transition-colors data-[next=true]:border-orange/50 data-[next=true]:bg-orange/6"
    data-event-card
    data-event-date={event.date}
    data-next={isNext}
    open={isNext}
>
    {/* The artboard keeps the header to three things: the date, what the
        night is called, and the marker. Everything else waits until the card
        is open, which is what stops it turning into a wall of text. */}
    <summary class="flex items-center gap-3.5 p-4 sm:gap-7 sm:p-7">
        <EventDate date={event.date} accent={isNext} />

        <div class="min-w-0 flex-1">
            <div class="flex flex-wrap items-center gap-2">
                <Badge
                    tone={isToday ? 'solid' : isNext ? 'gold' : 'muted'}
                    class="group-data-[next=false]:hidden"
                >
                    {isToday ? t.nextEvent.todayLabel : t.nextEvent.nextLabel}
                </Badge>
                {event.cancelled && <Badge tone="muted">{t.nextEvent.cancelled}</Badge>}
            </div>

            <h3
                id={headingId}
                class="mt-2 font-display text-h3 leading-tight-2 font-medium tracking-tiny text-cream uppercase"
            >
                {heading}
            </h3>

            {/* The date column already says this, so it only appears where
                there is room beside it. */}
            {
                event.title && (
                    <p class="mt-1 hidden font-display text-md tracking-label text-gold uppercase lg:block">
                        {longDate}
                    </p>
                )
            }
        </div>

        {/* Boxed, as in the artboard: on a card this wide a bare chevron does
            not read as something you can press. */}
        <span
            class="disclosure-marker ml-auto flex size-10 shrink-0 items-center justify-center border border-gold/40 text-gold transition-colors group-hover:border-gold group-hover:text-gold-light sm:size-11"
            aria-hidden="true"
        >
            <Icon name="chevron-down" size={18} />
        </span>
    </summary>

    <div class="px-4 pb-1 sm:px-7">
        {
            (event.summary ?? event.description) && (
                <p class="max-w-[62ch] pb-1 text-md leading-snug-2 text-cream/70">
                    {(event.summary ?? event.description)![locale]}
                </p>
            )
        }

        <EventSchedule event={event} />
    </div>

    <div
        class="flex flex-col gap-5 border-t border-gold/20 p-4 sm:p-7 lg:flex-row lg:items-end lg:justify-between"
    >
        <div class="flex flex-col gap-2">
            <p class="flex items-start gap-2.5 text-md leading-snug-2 text-cream/80">
                <span class="mt-0.5 text-gold" aria-hidden="true">
                    <Icon name="map-pin" size={17} />
                </span>
                <span>
                    <strong class="font-semibold text-cream">{site.venue.name}</strong><br
                    />
                    {site.venue.street} · {site.venue.postalCode} {site.venue.city}
                </span>
            </p>
            <p class="flex items-start gap-2.5 text-md leading-snug-2 text-cream/80">
                <span class="mt-0.5 text-gold" aria-hidden="true">
                    <Icon name="clock" size={17} />
                </span>
                <span>
                    {t.event.priceStandard} {site.prices.standard} €
                    <span class="text-cream/40"> · </span>
                    {t.event.priceReduced} {site.prices.reduced} €
                </span>
            </p>
            <p class="text-sm text-cream/55">{t.nextEvent.arriveNote}</p>
            {
                !hasSpecificBookingLinks(event) && (
                    <p class="max-w-[62ch] text-sm text-cream/45">
                        {t.nextEvent.bookingFallbackNote}
                    </p>
                )
            }
        </div>

        <div class="flex flex-col gap-3 sm:flex-row lg:shrink-0">
            <Button href={bookingUrlFor(event, 'salsa-basics')} external size="lg">
                {t.nextEvent.ctaClasses}
                <Icon name="external" size={16} />
            </Button>
            <Button
                href={eventPathFor(event.slug, locale)}
                variant="secondary"
                size="lg"
            >
                {t.nextEvent.details}
                <Icon name="arrow-right" size={16} />
            </Button>
        </div>
    </div>
</details>
