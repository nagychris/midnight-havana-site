---
import Badge from '../ui/Badge.astro';
import BookingRow from './BookingRow.astro';
import UscLink from './UscLink.astro';
import Icon from '../ui/Icon.astro';
import { site } from '../../data/site';
import { bookingUrlFor } from '../../lib/booking';
import { classNameOn, classesOn } from '../../lib/event-classes';
import type { SiteEvent } from '../../lib/events';
import { localeFromAstro, useTranslations } from '../../i18n';

/**
 * The timetable for one date, with a booking link per class.
 *
 * Each class is one tappable `BookingRow` rather than a labelled button. Four
 * buttons stacked on a phone read as a wall of equal-weight choices and push
 * the card's real primary action off the screen. The event page's timetable
 * uses the same row, so booking looks the same in both places.
 *
 * Extras such as a guest workshop get a row of their own above the classes.
 */
interface Props {
    event: SiteEvent;
}

const { event } = Astro.props;

const locale = localeFromAstro(Astro.currentLocale);
const t = useTranslations(locale);
const classesTonight = classesOn(event);
const startTimes = [...new Set(classesTonight.map((c) => c.startTime))].sort();
const classesStartingAt = (startTime: string) =>
    classesTonight
        .filter((danceClass) => danceClass.startTime === startTime)
        .sort((a, b) => a.order - b.order);
const extras = [...event.extras].sort((a, b) =>
    a.startTime.localeCompare(b.startTime),
);
---

<div class="flex flex-col">
    {
        extras.map((extra) => (
            <div class="rule-top grid gap-2 py-3 sm:grid-cols-[5rem_minmax(0,1fr)] sm:gap-6 sm:py-5">
                <p class="font-display text-xl leading-flat font-medium text-gold-light sm:text-h4">
                    {extra.startTime}
                    {extra.endTime && (
                        <span class="mt-0.5 block text-sm font-normal text-cream/45">
                            – {extra.endTime}
                        </span>
                    )}
                </p>
                <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
                    <h4 class="font-display text-lg font-medium tracking-tiny text-cream uppercase">
                        {extra.title[locale]}
                    </h4>
                    {extra.level && <Badge tone="gold">{extra.level}</Badge>}
                    {extra.description && (
                        <p class="w-full text-sm text-cream/55">
                            {extra.description[locale]}
                        </p>
                    )}
                    {extra.booking && (
                        <a
                            href={extra.booking}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="inline-flex items-center gap-1.5 font-display text-sm tracking-label text-gold uppercase hover:text-gold-light"
                        >
                            {t.nextEvent.bookNow}
                            <Icon name="external" size={14} />
                        </a>
                    )}
                </div>
            </div>
        ))
    }

    {
        startTimes.map((startTime, index) => (
            <div class="rule-top grid gap-2 py-3 sm:grid-cols-[5rem_minmax(0,1fr)] sm:gap-6 sm:py-5">
                <p class="font-display text-xl leading-flat font-medium text-orange sm:text-h4">
                    {startTime}
                    {t.nextEvent.classesAt && (
                        <span class="ml-1 text-sm font-normal text-cream/45">
                            {t.nextEvent.classesAt}
                        </span>
                    )}
                </p>

                <div class="min-w-0">
                <ul class="grid gap-2 sm:grid-cols-2 sm:gap-3">
                    {classesStartingAt(startTime).map((danceClass) => {
                        const name = classNameOn(event, danceClass.id, locale, t);
                        return (
                            <li>
                                <BookingRow
                                    href={bookingUrlFor(event, danceClass.id)}
                                    name={name}
                                    level={danceClass.level}
                                    levelTone={danceClass.track === 'rueda' ? 'green' : 'gold'}
                                    analyticsKey={danceClass.id}
                                />
                            </li>
                        );
                    })}
                </ul>
                {/* Right after the rows it is an alternative to. */}
                {index === startTimes.length - 1 && (
                    <UscLink event={event} class="mt-2 sm:mt-3" />
                )}
                </div>
            </div>
        ))
    }

    <div
        class="rule-top grid gap-2 py-3 sm:grid-cols-[5rem_minmax(0,1fr)] sm:gap-6 sm:py-5"
    >
        <p class="font-display text-xl leading-flat font-medium text-orange sm:text-h4">
            {site.schedule.socialDance}
        </p>
        <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
            <h4
                class="font-display text-lg font-medium tracking-tiny text-cream uppercase"
            >
                {t.nextEvent.socialDance}
            </h4>
            {
                event.dj && (
                    <span class="font-display text-sm tracking-label text-gold uppercase">
                        {event.dj}
                    </span>
                )
            }
            <p class="hidden w-full text-sm text-cream/55 sm:block">{t.event.socialNote}</p>
        </div>
    </div>
</div>
