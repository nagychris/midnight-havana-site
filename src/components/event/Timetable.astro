---
import Badge from '../ui/Badge.astro';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import { timetableFor, type TimetableTone } from '../../lib/timetable';
import type { SiteEvent } from '../../lib/events';
import { localeFromAstro, useTranslations } from '../../i18n';

/**
 * The running order of one night.
 *
 * One row per time. Where two classes run in parallel they sit side by side
 * under a single time, rather than appearing as two rows that both say 19:00.
 *
 * On a phone the time sits above its entries; from the small breakpoint up it
 * moves into its own column, so the times line up as an index down the page.
 */
interface Props {
    event: SiteEvent;
    class?: string;
}

const { event, class: className } = Astro.props;

const locale = localeFromAstro(Astro.currentLocale);
const t = useTranslations(locale);
const slots = timetableFor(event, locale, t);

const timeColour: Record<TimetableTone, string> = {
    doors: 'text-cream/45',
    salsa: 'text-orange',
    rueda: 'text-green',
    extra: 'text-gold-light',
    social: 'text-orange',
};

const badgeTone: Record<TimetableTone, 'gold' | 'green' | 'muted'> = {
    doors: 'muted',
    salsa: 'gold',
    rueda: 'green',
    extra: 'gold',
    social: 'muted',
};

/** A slot of parallel classes takes its accent from the first of them. */
const slotTone = (tones: TimetableTone[]): TimetableTone => tones[0];
---

<ol class:list={['flex flex-col', className]}>
    {
        slots.map((slot) => {
            const tone = slotTone(slot.entries.map((entry) => entry.tone));
            const isClassSlot = slot.entries.length > 1;

            return (
                <li class="rule-top grid gap-3 py-5 sm:grid-cols-[6.5rem_minmax(0,1fr)] sm:gap-7 sm:py-6">
                    <p class="font-display leading-flat font-medium">
                        <time class:list={['text-h4', timeColour[tone]]}>
                            {slot.startTime}
                        </time>
                        {slot.endTime && (
                            <span class="mt-0.5 block text-sm font-normal text-cream/35">
                                – {slot.endTime}
                            </span>
                        )}
                    </p>

                    <ul
                        class:list={[
                            'grid min-w-0 gap-4',
                            isClassSlot && 'sm:grid-cols-2 sm:gap-x-6',
                        ]}
                    >
                        {slot.entries.map((entry) => (
                            <li class="min-w-0">
                                <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
                                    <h3 class="font-display text-lg font-medium tracking-tiny text-cream uppercase sm:text-xl">
                                        {entry.title}
                                    </h3>
                                    {entry.level && (
                                        <Badge tone={badgeTone[entry.tone]}>
                                            {entry.level}
                                        </Badge>
                                    )}
                                </div>

                                {entry.description && (
                                    <p class="mt-2 max-w-[60ch] text-md leading-snug-2 text-cream/65">
                                        {entry.description}
                                    </p>
                                )}

                                {entry.bookingUrl && (
                                    <Button
                                        href={entry.bookingUrl}
                                        external
                                        variant="secondary"
                                        class="mt-3"
                                    >
                                        {t.nextEvent.bookOnPlatform}
                                        <Icon name="external" size={15} />
                                    </Button>
                                )}
                            </li>
                        ))}
                    </ul>
                </li>
            );
        })
    }
</ol>
