---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import TonightStrip from "../components/TonightStrip.astro";
import NextDates from "../components/NextDates.astro";
import StartHere from "../components/StartHere.astro";
import Courses from "../components/Courses.astro";
import FridayRun from "../components/FridayRun.astro";
import Gallery from "../components/Gallery.astro";
import Venue from "../components/Venue.astro";
import Faq from "../components/Faq.astro";
import CommunityCta from "../components/CommunityCta.astro";
import Footer from "../components/Footer.astro";

// The artboard's two editable props; both defaulted to true.
const showLangSwitcher = true;
const showPosterThumbs = true;
---

<Base>
  <Header showLangSwitcher={showLangSwitcher} />
  <!-- Hero + strip share one viewport so the next date is visible without
       scrolling. The header stays outside, or it would stop being sticky once
       this wrapper scrolled past. -->
  <div class="flex min-h-[calc(100dvh-var(--mh-header-h))] flex-col">
    <Hero />
    <TonightStrip />
  </div>
  <NextDates showPosterThumbs={showPosterThumbs} />
  <StartHere />
  <Courses />
  <FridayRun />
  <Gallery />
  <Venue />
  <Faq />
  <CommunityCta />
  <Footer />
</Base>
