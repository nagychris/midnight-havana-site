---
import '../styles/global.css';

import Seo from '../components/seo/Seo.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import ConsentBanner from '../components/ConsentBanner.astro';
import WordmarkSprite from '../components/brand/WordmarkSprite.astro';
import Analytics from '../components/Analytics.astro';
import {
    htmlLang,
    localeFromAstro,
    useTranslations,
    type LocalisedPaths,
} from '../i18n';

/**
 * The shell every page uses: head, header, footer, consent, analytics.
 *
 * A page passes its paths in both languages and its own title and description.
 * Everything that has to stay consistent across the site is decided here.
 */
interface Props {
    /** This page's path in every language, including its own. */
    paths: LocalisedPaths;
    title: string;
    description: string;
    ogImage?: string;
    ogType?: 'website' | 'article';
    noindex?: boolean;
    /** Lets the hero run under the header instead of starting below it. */
    transparentHeader?: boolean;
}

const {
    paths,
    title,
    description,
    ogImage,
    ogType,
    noindex = false,
    transparentHeader = false,
} = Astro.props;

const locale = localeFromAstro(Astro.currentLocale);
const t = useTranslations(locale);
---

<!doctype html>
<html lang={htmlLang[locale]}>
    <head>
        <Seo
            locale={locale}
            paths={paths}
            title={title}
            description={description}
            ogImage={ogImage}
            ogImageAlt={t.meta.ogImageAlt}
            ogType={ogType}
            noindex={noindex}
        />
        <slot name="head" />
    </head>

    <body>
        <WordmarkSprite />

        <a
            href="#main"
            class="sr-only rounded-sharp bg-orange px-5 py-3 font-display text-sm tracking-label text-ink uppercase focus-visible:not-sr-only focus-visible:fixed focus-visible:top-3 focus-visible:left-3 focus-visible:z-70"
        >
            {t.nav.skipToContent}
        </a>

        <Header paths={paths} transparent={transparentHeader} />

        <main id="main">
            <slot />
        </main>

        <Footer />
        <ConsentBanner />
        <Analytics />

        <script>
            /**
             * Fades sections in as they scroll into view.
             *
             * Arming the effect is the first thing this does: the CSS only
             * hides a section while the root element carries `is-revealing`.
             * If this script never runs, every section renders as normal.
             */
            const sections = document.querySelectorAll<HTMLElement>('[data-reveal]');
            const canObserve = 'IntersectionObserver' in window;

            if (sections.length > 0 && canObserve) {
                document.documentElement.classList.add('is-revealing');

                const reveal = (section: HTMLElement) => {
                    section.dataset.reveal = 'shown';
                };

                const observer = new IntersectionObserver(
                    (entries) => {
                        entries.forEach((entry) => {
                            if (!entry.isIntersecting) return;
                            reveal(entry.target as HTMLElement);
                            observer.unobserve(entry.target);
                        });
                    },
                    { rootMargin: '0px 0px -10% 0px', threshold: 0.05 },
                );

                sections.forEach((section) => observer.observe(section));

                // Safety net: whatever happens, nothing stays hidden for long.
                window.setTimeout(() => sections.forEach(reveal), 4000);
            }
        </script>
    </body>
</html>
